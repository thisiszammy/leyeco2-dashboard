@namespace Leyeco2Dashboard.Client.Components.Shared

@* A password field with its show/hide toggle and, where a first password is being chosen for
   someone else, a button that makes one up and shows it so it can be handed over. *@
<div class="pw-field">
    <input id="@Id"
           class="ob-input"
           type="@(_revealed ? "text" : "password")"
           autocomplete="@Autocomplete"
           autocapitalize="off"
           spellcheck="false"
           maxlength="@PasswordRules.MaxLength"
           placeholder="@Placeholder"
           disabled="@Disabled"
           value="@Value"
           @ref="_input"
           @oninput="OnInputAsync" />

    <button type="button"
            class="pw-btn"
            aria-label="@(_revealed ? "Hide password" : "Show password")"
            title="@(_revealed ? "Hide password" : "Show password")"
            aria-pressed="@(_revealed ? "true" : "false")"
            disabled="@Disabled"
            @onclick="ToggleReveal">
        <Icon Name="@(_revealed ? "eyeSlash" : "eye")" />
    </button>

    @if (AllowGenerate)
    {
        <button type="button"
                class="pw-btn"
                aria-label="Generate a password"
                title="Generate a password"
                disabled="@Disabled"
                @onclick="GenerateAsync">
            <Icon Name="wand" />
        </button>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>"current-password" where the account's own password is asked for; "new-password" where one is being chosen.</summary>
    [Parameter] public string Autocomplete { get; set; } = "new-password";

    /// <summary>Offers a made-up password: for one an administrator hands to someone else, never for the account's own.</summary>
    [Parameter] public bool AllowGenerate { get; set; }

    private ElementReference _input;
    private bool _revealed;

    public ValueTask FocusAsync() => _input.FocusAsync();

    /// <summary>Hides the characters again, for a dialog that opens anew.</summary>
    public void Conceal() => _revealed = false;

    private Task OnInputAsync(ChangeEventArgs e) => ValueChanged.InvokeAsync(e.Value?.ToString() ?? "");

    private void ToggleReveal() => _revealed = !_revealed;

    private Task GenerateAsync()
    {
        // Shown at once: whoever generates it has to read it to pass it on.
        _revealed = true;
        return ValueChanged.InvokeAsync(PasswordRules.Generate());
    }
}
