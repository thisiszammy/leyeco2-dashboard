@namespace Leyeco2Dashboard.Client.Features.Authentication.Components
@inject AuthApiClient Auth
@inject SessionAuthenticationStateProvider AuthState
@inject ToastService Toasts

@* The signed-in account's own password, changed on proof of the current one. *@
@if (IsOpen)
{
<SectionContent SectionName="overlay">
    <div class="modal-overlay">
        <div class="modal"
             role="dialog"
             aria-modal="true"
             aria-label="Change password"
             @onclick:stopPropagation
             @onkeydown="HandleKeyDownAsync">

            <div class="modal-header">
                <h3>Change Password</h3>
                <button type="button" class="modal-close-btn" aria-label="Close dialog" disabled="@_busy" @onclick="RequestCloseAsync">
                    <Icon Name="x" />
                </button>
            </div>

            <form class="cpm-form" @onsubmit="HandleSaveAsync" @onsubmit:preventDefault>
                <div class="modal-body">
                    @* Lets a password manager file the new password under the right account. *@
                    <input class="sr-only" type="text" autocomplete="username" tabindex="-1" aria-hidden="true" readonly value="@Username" />

                    @if (_error is not null)
                    {
                        <div class="modal-error" role="alert">
                            <Icon Name="warning" />
                            <span>@_error</span>
                        </div>
                    }

                    <div class="form-group" style="margin-bottom:0">
                        <label for="cpm-current">Current password</label>
                        <PasswordInput @ref="_currentInput"
                                       Id="cpm-current"
                                       Value="@_current"
                                       ValueChanged="@(value => _current = value)"
                                       Autocomplete="current-password"
                                       Disabled="_busy" />
                        @if (_showErrors && string.IsNullOrEmpty(_current))
                        {
                            <div class="field-error"><Icon Name="warning" />Enter your current password.</div>
                        }
                    </div>

                    <div class="form-group" style="margin-bottom:0">
                        <label for="cpm-new">New password</label>
                        <PasswordInput @ref="_newInput"
                                       Id="cpm-new"
                                       Value="@_new"
                                       ValueChanged="@(value => _new = value)"
                                       Disabled="_busy" />
                        @if (_showErrors && NewError is { } newError)
                        {
                            <div class="field-error"><Icon Name="warning" />@newError</div>
                        }
                        else
                        {
                            <div class="field-helper">@PasswordRules.Hint</div>
                        }
                    </div>

                    <div class="form-group" style="margin-bottom:0">
                        <label for="cpm-confirm">Type the new password again</label>
                        <PasswordInput @ref="_confirmInput"
                                       Id="cpm-confirm"
                                       Value="@_confirm"
                                       ValueChanged="@(value => _confirm = value)"
                                       Disabled="_busy" />
                        @if (_showErrors && NewError is null && _confirm != _new)
                        {
                            <div class="field-error"><Icon Name="warning" />The two passwords don't match.</div>
                        }
                    </div>

                    <p class="cpm-note">You stay signed in here. Anywhere else this account is signed in, it is signed out.</p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="RequestCloseAsync">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="key" />
                            <span>Change Password</span>
                        }
                    </button>
                </div>
            </form>

        </div>
    </div>
</SectionContent>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _current = "";
    private string _new = "";
    private string _confirm = "";
    private bool _showErrors;
    private bool _busy;
    private string? _error;
    private bool _wasOpen;
    private bool _focusPending;

    private PasswordInput? _currentInput;
    private PasswordInput? _newInput;
    private PasswordInput? _confirmInput;

    private string Username => AuthState.CurrentUser?.Username ?? "";

    private string? NewError
        => PasswordRules.Check(_new, Username)
           ?? (_new == _current ? "Choose a password different from your current one." : null);

    protected override void OnParametersSet()
    {
        if (IsOpen == _wasOpen)
            return;

        _wasOpen = IsOpen;
        if (!IsOpen)
            return;

        _current = _new = _confirm = "";
        _showErrors = false;
        _error = null;
        _focusPending = true;
        _currentInput?.Conceal();
        _newInput?.Conceal();
        _confirmInput?.Conceal();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && IsOpen && _currentInput is not null)
        {
            _focusPending = false;
            try { await _currentInput.FocusAsync(); }
            catch { /* element may not be rendered yet on a fast close — never crash over focus */ }
        }
    }

    private async Task RequestCloseAsync()
    {
        if (_busy) return;
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await RequestCloseAsync();
    }

    private async Task HandleSaveAsync()
    {
        if (_busy) return;

        _error = null;

        var invalid = string.IsNullOrEmpty(_current) ? _currentInput
            : NewError is not null ? _newInput
            : _confirm != _new ? _confirmInput
            : null;

        if (invalid is not null)
        {
            _showErrors = true;
            try { await invalid.FocusAsync(); }
            catch { /* the error still shows */ }
            return;
        }

        _busy = true;
        try
        {
            // The API answers with the session it re-opened under the new password.
            var user = await Auth.ChangePasswordAsync(null, _current, _new);
            AuthState.MarkSignedIn(user);
            Toasts.Success("Password changed", "Your other sessions were signed out.");
            await OnClose.InvokeAsync();
        }
        catch (ApiException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
