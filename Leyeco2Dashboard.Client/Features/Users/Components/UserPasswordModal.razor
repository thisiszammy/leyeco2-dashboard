@namespace Leyeco2Dashboard.Client.Features.Users.Components
@implements IDisposable
@inject IJSRuntime JS

@* An administrator's password for someone else's account, in two steps: choose it, then hand it over. Once
   saved, the dialog stays open on the username and the password, each with a Copy button, because nothing else
   shows that password again. Closing the dialog drops it. *@
@if (IsOpen && User is not null)
{
<SectionContent SectionName="overlay">
    <div class="modal-overlay">
        @* tabindex="-1": a click on its text (selecting the password by hand) leaves focus in the dialog, so Esc still closes it. *@
        <div class="modal"
             role="dialog"
             aria-modal="true"
             aria-label="@Title"
             tabindex="-1"
             @onclick:stopPropagation
             @onkeydown="HandleKeyDownAsync">

            <div class="modal-header">
                <h3>@Title</h3>
                <button type="button" class="modal-close-btn" aria-label="Close dialog" disabled="@IsLocked" @onclick="RequestCloseAsync">
                    <Icon Name="x" />
                </button>
            </div>

            <div class="modal-body">
                <UserIdentityLine User="User" />

                @if (Issued is not null)
                {
                    <div class="upm-issued">
                        <p class="upm-saved" role="status">
                            <Icon Name="circleCheck" />
                            <span>
                                <strong>@(Issued.IsFirstPassword ? "Password set." : "Password reset.")</strong>
                                @(Issued.IsFirstPassword
                                    ? " The account can sign in now."
                                    : " The account was signed out wherever it was signed in.")
                            </span>
                        </p>

                        @* The slip: what to hand over, each line in the register's margin-and-rule form. *@
                        <dl class="upm-slip" aria-label="Sign-in details to hand over">
                            <div class="upm-slip-row">
                                <dt>Username</dt>
                                <dd>
                                    <span class="upm-slip-value t-code">@Issued.Username</span>
                                    <button type="button"
                                            class="btn btn-secondary btn-sm upm-copy @(_copied == CopyTarget.Username ? "is-copied" : null)"
                                            aria-label="@(_copied == CopyTarget.Username ? "Username copied" : "Copy the username")"
                                            @onclick="() => CopyAsync(CopyTarget.Username)">
                                        <Icon Name="@(_copied == CopyTarget.Username ? "check" : "copy")" />
                                        <span>@(_copied == CopyTarget.Username ? "Copied" : "Copy")</span>
                                    </button>
                                </dd>
                            </div>
                            <div class="upm-slip-row">
                                <dt>Password</dt>
                                <dd>
                                    @* Spelled out for reading aloud or copying by hand: digits in navy, anything
                                       that is neither letter nor digit in gold, so a 0 or a dash is never missed. *@
                                    <span class="upm-slip-value upm-password" aria-hidden="true">@foreach (var c in Issued.Password){<span class="@CharClass(c)">@c</span>}</span>
                                    <span class="sr-only">@Issued.Password</span>
                                    <button type="button"
                                            class="btn btn-secondary btn-sm upm-copy @(_copied == CopyTarget.Password ? "is-copied" : null)"
                                            aria-label="@(_copied == CopyTarget.Password ? "Password copied" : "Copy the password")"
                                            @ref="_copyPasswordButton"
                                            @onclick="() => CopyAsync(CopyTarget.Password)">
                                        <Icon Name="@(_copied == CopyTarget.Password ? "check" : "copy")" />
                                        <span>@(_copied == CopyTarget.Password ? "Copied" : "Copy")</span>
                                    </button>
                                </dd>
                            </div>
                        </dl>

                        @if (_copyFailed)
                        {
                            <div class="field-error" role="alert">
                                <Icon Name="warning" />
                                <span>The browser didn't allow copying. Select the text and copy it with Ctrl+C.</span>
                            </div>
                        }

                        <p class="user-password-note">
                            @(Issued.MustChangePassword
                                ? "At its next sign-in the account replaces this password with one only it knows."
                                : "The account keeps this password until it changes it.")
                            The password isn't shown again after you close this.
                        </p>

                        <span class="sr-only" aria-live="polite">@_announcement</span>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="modal-error" role="alert">
                            <Icon Name="warning" />
                            <span>@ErrorMessage</span>
                        </div>
                    }

                    <div class="form-group" style="margin-bottom:0">
                        <label for="user-password-new">New password</label>
                        <PasswordInput @ref="_passwordInput"
                                       Id="user-password-new"
                                       Value="@_password"
                                       ValueChanged="OnPasswordChanged"
                                       AllowGenerate="true"
                                       Disabled="Busy" />
                        @if (_showErrors && PasswordError is not null)
                        {
                            <div class="field-error"><Icon Name="warning" />@PasswordError</div>
                        }
                        else
                        {
                            <div class="field-helper">@PasswordRules.Hint</div>
                        }
                    </div>

                    <div class="user-password-switch">
                        <button type="button"
                                class="ob-toggle user-switch"
                                role="switch"
                                aria-checked="@(_mustChangePassword ? "true" : "false")"
                                aria-labelledby="user-password-must"
                                aria-describedby="user-password-must-help"
                                style="@(_mustChangePassword ? "background:var(--brand-primary)" : "background:var(--slate-200)")"
                                disabled="@Busy"
                                @onclick="() => _mustChangePassword = !_mustChangePassword">
                            <span class="ob-toggle-knob" style="@(_mustChangePassword ? "left:16px" : "left:2px")"></span>
                        </button>
                        <div>
                            <span class="ob-field-label" id="user-password-must" style="margin-bottom:0">Ask for a new password at next sign-in</span>
                            <div class="field-helper" id="user-password-must-help" style="margin-top:0">
                                @(_mustChangePassword
                                    ? "The account sets a password only it knows before it gets in."
                                    : "The account keeps this password until it changes it.")
                            </div>
                        </div>
                    </div>

                    <p class="user-password-note">
                        @if (IsFirstPassword)
                        {
                            <text>This account has no password yet. Setting one lets it sign in with the access it holds.</text>
                        }
                        else
                        {
                            <text>Saving signs the account out wherever it is signed in, and lifts a lock.</text>
                        }
                        <text> The password is shown once more after saving, so you can hand it over.</text>
                    </p>
                }
            </div>

            <div class="modal-footer">
                @if (Issued is not null)
                {
                    <button type="button" class="btn btn-primary" @onclick="RequestCloseAsync">Done</button>
                }
                else
                {
                    <button type="button" class="btn btn-secondary" disabled="@Busy" @onclick="RequestCloseAsync">Cancel</button>
                    <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="HandleSaveAsync">
                        @if (Busy)
                        {
                            <span class="btn-spinner" aria-hidden="true"></span>
                            <span>Saving…</span>
                        }
                        else
                        {
                            <Icon Name="key" />
                            <span>@(IsFirstPassword ? "Set Password" : "Reset Password")</span>
                        }
                    </button>
                }
            </div>

        </div>
    </div>
</SectionContent>
}

@code {
    public record SaveResult(string Password, bool MustChangePassword);

    /// <summary>A password that was saved, kept on screen until the dialog closes so it can be handed over.</summary>
    public record IssuedPassword(string Username, string Password, bool MustChangePassword, bool IsFirstPassword);

    private enum CopyTarget { None, Username, Password }

    private const int CopiedFeedbackMs = 2000;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public UserDto? User { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }

    /// <summary>Set by the page once the save went through: the dialog turns to the handover.</summary>
    [Parameter] public IssuedPassword? Issued { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SaveResult> OnSave { get; set; }

    private string _password = "";
    private bool _mustChangePassword = true;
    private bool _showErrors;
    private bool _focusPending;
    private bool _wasOpen;
    private Guid? _lastUserId;
    private PasswordInput? _passwordInput;

    private IssuedPassword? _lastIssued;
    private bool _focusCopyPending;
    private ElementReference _copyPasswordButton;
    private CopyTarget _copied;
    private bool _copyFailed;
    private string? _announcement;
    private CancellationTokenSource? _copiedCts;

    private bool IsFirstPassword => User?.Status == UserAccountStatus.NoPassword;

    /// <summary>While a save is on its way the dialog can't be closed; once the password is issued, nothing holds it.</summary>
    private bool IsLocked => Busy && Issued is null;

    private string Title => Issued is not null ? "Hand Over the Password"
        : IsFirstPassword ? "Set Password"
        : "Reset Password";

    private string? PasswordError => PasswordRules.Check(_password, User?.Username);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Issued, _lastIssued))
        {
            _lastIssued = Issued;
            ResetCopyState();
            if (Issued is not null)
            {
                // What was typed has done its job; the handover shows the saved copy.
                _password = "";
                _focusCopyPending = true;
            }
        }

        var userId = User?.UserId;
        if (IsOpen == _wasOpen && userId == _lastUserId)
            return;

        _wasOpen = IsOpen;
        _lastUserId = userId;

        if (IsOpen)
        {
            _password = "";
            _mustChangePassword = true;
            _showErrors = false;
            _focusPending = true;
            _passwordInput?.Conceal();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusCopyPending && IsOpen && Issued is not null)
        {
            // The likely next move is copying the password; Tab reaches Done.
            _focusCopyPending = false;
            try { await _copyPasswordButton.FocusAsync(); }
            catch { /* the dialog may have closed already — never crash over focus */ }
            return;
        }

        if (_focusPending && IsOpen && Issued is null && _passwordInput is not null)
        {
            _focusPending = false;
            try { await _passwordInput.FocusAsync(); }
            catch { /* element may not be rendered yet on a fast close — never crash over focus */ }
        }
    }

    private void OnPasswordChanged(string value) => _password = value;

    private async Task RequestCloseAsync()
    {
        if (IsLocked) return;
        await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await RequestCloseAsync();
    }

    private async Task HandleSaveAsync()
    {
        if (Busy || Issued is not null) return;

        if (PasswordError is not null)
        {
            _showErrors = true;
            if (_passwordInput is not null)
            {
                try { await _passwordInput.FocusAsync(); }
                catch { /* the error still shows */ }
            }
            return;
        }

        await OnSave.InvokeAsync(new SaveResult(_password, _mustChangePassword));
    }

    private async Task CopyAsync(CopyTarget target)
    {
        if (Issued is not { } issued) return;

        var text = target == CopyTarget.Username ? issued.Username : issued.Password;
        bool copied;
        try
        {
            copied = await JS.InvokeAsync<bool>("monitorClipboard.copy", text);
        }
        catch (JSException)
        {
            copied = false;
        }

        _copiedCts?.Cancel();
        _copiedCts?.Dispose();
        _copiedCts = null;

        if (!copied)
        {
            _copied = CopyTarget.None;
            _copyFailed = true;
            _announcement = null;
            return;
        }

        _copyFailed = false;
        _copied = target;
        _announcement = target == CopyTarget.Username ? "Username copied." : "Password copied.";
        StateHasChanged(); // the handler renders again only when it ends, two seconds from now

        // "Copied" stands for a moment, then the button offers to copy again.
        var cts = _copiedCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(CopiedFeedbackMs, cts.Token);
        }
        catch (OperationCanceledException)
        {
            return; // another copy, or the dialog closed
        }

        if (_copied == target)
            _copied = CopyTarget.None;
    }

    private void ResetCopyState()
    {
        _copiedCts?.Cancel();
        _copiedCts?.Dispose();
        _copiedCts = null;
        _copied = CopyTarget.None;
        _copyFailed = false;
        _announcement = null;
    }

    private static string? CharClass(char c) => c switch
    {
        _ when char.IsAsciiDigit(c) => "is-digit",
        _ when char.IsLetter(c) => null,
        ' ' => "is-space",
        _ => "is-symbol",
    };

    public void Dispose()
    {
        _copiedCts?.Cancel();
        _copiedCts?.Dispose();
    }
}
