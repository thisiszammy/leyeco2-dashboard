<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @* A page names its screen's grant ([Authorize(Policy = MonitorPolicies.…)]); an account without it gets
               NoAccess in the shell instead, and MainLayout sends a signed-out one to the sign-in page. *@
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <NoAccess PageType="routeData.PageType" />
                </NotAuthorized>
                <Authorizing />
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector=".page-header h2, .login-form h2" />
        </Found>
    </Router>
</CascadingAuthenticationState>
