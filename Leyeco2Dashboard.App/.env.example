# Leyeco2Dashboard.App configuration. Copy to .env beside this file and fill in the values; .env is
# git-ignored and is read at startup by DotNetEnv (a double underscore stands for the ":" of a
# configuration key: Jwt__Key__l2auth is Jwt:Key:l2auth). Command-line arguments override it.

# ---- Database ---------------------------------------------------------------------------
# The Transaction Monitor's database (DatabaseContext): its accounts, their grants and sessions,
# and the audit trail. On the SQL Server of this machine, with the Windows account the API runs as:
ConnectionStrings__DatabaseConnection=Server=localhost;Database=Leyeco2Dashboard;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
# With a SQL login instead:
# ConnectionStrings__DatabaseConnection=Server=<host>;Database=Leyeco2Dashboard;User ID=<user>;Password=<password>;TrustServerCertificate=True;MultipleActiveResultSets=true

# ---- The dashboards' sources (read only) ---------------------------------------------------
# The legacy cashiering database that holds dbo.Collection_Transactions_History, which the overall
# dashboard reads: the source of truth for what was collected. A login that can only SELECT is enough.
# Run Leyeco2Dashboard.Data/Scripts/legacy-collections-performance.sql on it first: without its index
# a few weeks of collections are read by scanning the whole table. Optional: without it the API starts,
# and the dashboard says it isn't connected.
ConnectionStrings__LegacyConnection=Server=<host>;Database=<legacy database>;User ID=<user>;Password=<password>;TrustServerCertificate=True
# The online payment facility's database (Leyeco2OTF: dbo.Transactions and dbo.PaymentProviders), which
# the Online Payments dashboard reads. Its index: Scripts/online-payments-performance.sql. Optional, as above.
ConnectionStrings__OnlinePaymentsConnection=Server=<host>;Database=Leyeco2OTF;User ID=<user>;Password=<password>;TrustServerCertificate=True

# ---- Sign-in ----------------------------------------------------------------------------
# The Transaction Monitor keeps its own accounts (its Users screen) and signs their sessions itself.
# The first entry of Jwt__Issuers and of Jwt__Audience goes into every session token, and
# Jwt__Key__l2auth signs it: at least 32 characters, random, and secret (for example 64 hex
# characters from `openssl rand -hex 32`). Changing the key signs everyone out. Required.
Jwt__Issuers=l2auth
Jwt__Audience=l2auth
Jwt__Key__l2auth=<secret>
# How long a session token stands before it is renewed from the session cookie, in minutes:
# also how long a revoked permission or a deactivation can outlive its change. Optional (default 5).
# Jwt__AccessExpiryMinutes=5
# A session ends this many hours after its last use. Optional (default 12).
# Auth__SessionHours=12
# This many wrong passwords in a row lock an account, for this many minutes. Optional (5, 15).
# Auth__MaxFailedSignIns=5
# Auth__LockoutMinutes=15
# The Domain of the session cookies (l2auth_txm_*). Empty: host-only, on this API's host, which is
# what a console served from a sibling host (monitor.leyeco2.example calling
# monitor-api.leyeco2.example) needs. Optional.
Auth__CookieDomain=
# Renew an access token this many seconds before it expires. Optional (default 60).
Auth__PreemptiveRefreshSeconds=60

# ---- The first administrator -------------------------------------------------------------
# Someone must be able to open the Users screen before anyone else can be given an account.
# At start-up, while no active account can manage users, the API creates this one with All
# access. The password must meet the rule (8 or more characters, an upper-case letter, a
# lower-case letter and a number) and is replaced at the account's first sign-in. Once an
# administrator exists these two do nothing: remove them from .env.
Bootstrap__AdminUsername=admin
Bootstrap__AdminPassword=<a first password>

# ---- Logging ----------------------------------------------------------------------------
# Optional: without it the API logs to the console (and, in Release builds, to logs\ beside it).
# Seq__Url=http://<seq-host>:5341
